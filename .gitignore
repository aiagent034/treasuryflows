# Treasury Data Extractor - Git Ignore

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
*.whl

# Virtual environments
venv/
env/
ENV/
.venv

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Output files (except .gitkeep)
outputs/*.xlsx
outputs/*.png
outputs/*.json
outputs/*.csv
!outputs/.gitkeep

# Jupyter Notebook
.ipynb_checkpoints

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# mypy
.mypy_cache/

# Logs
*.log
